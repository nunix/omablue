#!/usr/bin/env bash
# ==============================================================================
# Omablue Update Manager - Decoupled Userland & System Updates
# ==============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

header() { echo -e "\n${BLUE}${BOLD}=== $* ===${NC}\n"; }
info() { echo -e "${GREEN}[info]${NC} $*"; }
warn() { echo -e "${YELLOW}[warn]${NC} $*"; }
err() { echo -e "${RED}[error]${NC} $*" >&2; }

MODE="userland"
UNATTENDED=false

for arg in "$@"; do
    case "$arg" in
        --system|-s)
            MODE="system"
            ;;
        --all|-a)
            MODE="all"
            ;;
        -y|--yes)
            UNATTENDED=true
            ;;
        --help|-h)
            echo "Usage: omablue-update [options]"
            echo ""
            echo "Options:"
            echo "  (no args)     Update userland (Mise, Distrobox Arch container, Flatpaks, Omarchy)"
            echo "  --system, -s  Update atomic base image (bootc / rpm-ostree)"
            echo "  --all, -a     Update both userland and system"
            echo "  -y, --yes     Unattended mode (assume yes to prompts)"
            exit 0
            ;;
    esac
done

update_userland() {
    header "1. Updating Mise Runtime & CLI Tools"
    if command -v mise &>/dev/null; then
        MISE_MINIMUM_RELEASE_AGE=0 mise upgrade || warn "Mise upgrade encountered warnings"
        info "Mise tools up to date."
    else
        warn "Mise not found, skipping."
    fi

    header "2. Updating Arch Linux Distrobox Container (omarchy)"
    if command -v distrobox &>/dev/null; then
        if distrobox list 2>/dev/null | grep -q "omarchy"; then
            info "Updating packages inside 'omarchy' Arch container..."
            distrobox enter omarchy -- sudo pacman -Syu --noconfirm || warn "Distrobox package upgrade failed"
            info "Arch container packages updated."
        else
            info "Container 'omarchy' not initialized yet. Initializing..."
            if [ -f /etc/distrobox/distrobox.ini ]; then
                distrobox assemble create --file /etc/distrobox/distrobox.ini || warn "Distrobox assemble failed"
            fi
        fi
    else
        warn "Distrobox not found, skipping."
    fi

    header "3. Updating Flatpaks"
    if command -v flatpak &>/dev/null; then
        flatpak update -y || warn "Flatpak update encountered warnings"
        info "Flatpaks up to date."
    fi

    header "4. Updating Omarchy Desktop Layer & Shell"
    if [ -d /usr/share/omarchy/.git ]; then
        info "Pulling latest Omarchy core..."
        git -C /usr/share/omarchy pull --ff-only 2>/dev/null || true
    elif [ -d "$HOME/.local/share/omarchy/.git" ]; then
        info "Pulling latest userland Omarchy..."
        git -C "$HOME/.local/share/omarchy" pull --ff-only 2>/dev/null || true
    fi

    if command -v omarchy-migrate &>/dev/null; then
        omarchy-migrate 2>/dev/null || true
    fi

    if command -v omarchy-restart-shell &>/dev/null; then
        omarchy-restart-shell 2>/dev/null || true
    fi

    info "${GREEN}Userland update completed successfully! No system reboot required.${NC}"
}

update_system() {
    header "Atomic System Update (bootc / ostree)"
    if command -v bootc &>/dev/null; then
        info "Checking and staging system container update via bootc..."
        if sudo bootc upgrade; then
            info "${GREEN}New atomic system image staged successfully.${NC}"
            if [[ "$UNATTENDED" == "false" ]]; then
                read -p "Would you like to reboot into the new deployment now? [y/N]: " choice
                case "$choice" in
                    y|Y)
                        info "Rebooting system..."
                        sudo reboot
                        ;;
                    *)
                        info "Reboot deferred. The new deployment will apply on your next restart."
                        ;;
                esac
            fi
        else
            warn "No new system updates found or upgrade check failed."
        fi
    elif command -v rpm-ostree &>/dev/null; then
        info "Checking system update via rpm-ostree..."
        sudo rpm-ostree upgrade || warn "rpm-ostree upgrade check completed"
    else
        err "Neither bootc nor rpm-ostree found on this host."
    fi
}

case "$MODE" in
    userland)
        update_userland
        ;;
    system)
        update_system
        ;;
    all)
        update_userland
        update_system
        ;;
esac
